{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "etude",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "etude/serve.mjs"
      ],
      "port": 4173
    },
    {
      "name": "olympiades",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "olympiades/serve.mjs"
      ],
      "port": 4174
    },
    {
      "name": "kit3d",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "noces-kit3d/serve.mjs"
      ],
      "port": 4175
    },
    {
      "name": "noces",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/wrangler/bin/wrangler.js",
        "dev",
        "--config",
        "noces-app/wrangler.toml",
        "--port",
        "4180",
        "--persist-to",
        "noces-app/.wrangler/state"
      ],
      "port": 4180
    },
    {
      "name": "noces-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "noces-app/noces-expo/scripts/serve-dist.mjs"
      ],
      "port": 8081
    },
    {
      "name": "site-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--local",
        "--port",
        "8799",
        "--var",
        "ADMIN_PASSWORD:localtest",
        "--var",
        "AUTH_SECRET:localsecret"
      ],
      "port": 8799
    }
  ]
}