  z-index: 10030;
  inset: 0;
  opacity: 0;
  transition: opacity .25s ease;
  pointer-events: none;
}
.motion-cursor.is-visible { opacity: 1; }
.motion-cursor__core,
.motion-cursor__ring {
  position: fixed;
  top: 0;
  left: 0;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  will-change: transform;
}
.motion-cursor__core {
  width: 8px;
  height: 8px;
  background: var(--it-red);
  box-shadow: 0 0 14px rgba(192, 32, 43, .65);
}
.motion-cursor__ring {
  width: 36px;
  height: 36px;
  border: 1px solid rgba(192, 32, 43, .68);
  background: rgba(247, 239, 217, .08);
  backdrop-filter: blur(2px);
  transition: width .28s cubic-bezier(.2, 0, 0, 1), height .28s cubic-bezier(.2, 0, 0, 1),
    background-color .28s ease, border-color .28s ease;
}
.motion-cursor.is-active .motion-cursor__ring {
  width: 58px;
  height: 58px;
  background: rgba(192, 32, 43, .12);
  border-color: rgba(192, 32, 43, .28);
}
