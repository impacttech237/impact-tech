.process__content,
.process-visual,
.cta-banner__card > * {
  position: relative;
  z-index: 1;
}

@media (hover: hover) and (pointer: fine) {
  .motion-ready,
  .motion-ready a,
  .motion-ready button,
  .motion-ready input,
  .motion-ready select,
  .motion-ready textarea {
    cursor: none !important;
  }
}
@media (prefers-reduced-motion: reduce) {
  .motion-wipe,
  .motion-cursor { display: none; }
  .newsletter__card::after,
  .process__card::after,
  .cta-banner__card::after { animation: none; }
