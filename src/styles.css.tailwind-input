.immersive-home .testi-title { color: var(--it-cream); font-size: clamp(2.8rem, 5vw, 5.8rem); }
.immersive-home .testi-sub { color: rgba(247,239,217,.48); }
.testi-stage { position: relative; margin-top: 8vh; cursor: grab; }
.testi-stage:active { cursor: grabbing; }
.testi-track {
  width: max-content;
  display: flex;
  gap: clamp(18px, 2.5vw, 36px);
  padding-inline: 8vw;
  will-change: transform;
}
.immersive-home .testi-card {
  width: clamp(300px, 31vw, 510px);
  min-height: 350px;
  flex: none;
  border-radius: 38px;
  background: #1b1b18;
  color: rgba(247,239,217,.72);
  border: 1px solid rgba(247,239,217,.1);
  box-shadow: 0 26px 70px rgba(0,0,0,.24);
}
.immersive-home .testi-text { font-size: clamp(1.1rem, 1.6vw, 1.45rem); color: var(--it-cream); }
.immersive-home .testi-author strong { color: var(--it-cream); }
.testi-drag-hint {
  margin: 42px auto 0;
  width: 150px;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border: 1px solid rgba(247,239,217,.18);
  border-radius: 100px;
  color: var(--it-cream);
  font-family: var(--f-head);
  font-size: .68rem;
  letter-spacing: .14em;
}

/* 09 — conviction 3D */
.immersive-home .bigtitle {
  min-height: 100svh;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: var(--it-cream);
  perspective: 1000px;
}
.bigtitle__grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(192,32,43,.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(192,32,43,.08) 1px, transparent 1px);
  background-size: 64px 64px;
}
.bigtitle__chapter { position: absolute; top: 6vh; left: 6vw; color: var(--it-red); }
.immersive-home .bigtitle h2 { font-size: clamp(4rem, 10vw, 11rem); line-height: .78; }

/* 10 — rail éditorial */
.immersive-home .blog {
  min-height: 100svh;
  padding: 9vh 0;
  overflow: hidden;
  background: var(--it-cream);
}
.immersive-home .blog > .container-it { max-width: none; padding-inline: 6vw; }
.immersive-home .blog-head { max-width: 980px; }
.immersive-home .blog-head h2 { font-size: clamp(3rem, 6vw, 7rem); line-height: .94; }
.immersive-home .blog-grid {
  display: flex;
  width: max-content;
  gap: 32px;
  margin-top: 8vh;
}
.immersive-home .blog-card { width: clamp(350px, 40vw, 650px); flex: none; }
.immersive-home .blog-card__inner { position: relative; border-radius: 40px; }
.blog-card__index {
  position: absolute;
  z-index: 5;
  right: 25px;
  top: 22px;
  color: var(--it-cream);
  font-family: var(--f-head);
  font-size: .72rem;
  letter-spacing: .15em;
}
.blog__progress {
  width: min(560px, 80vw);
  height: 3px;
  margin: 42px auto 0;
  background: rgba(26,26,23,.12);
  overflow: hidden;
}
.blog__progress span { display: block; width: 100%; height: 100%; background: var(--it-red); transform: scaleX(0); transform-origin: left center; }

.impact-particle {
  position: fixed;
  z-index: 11000;
  width: 9px;
  height: 9px;
  margin: -4px 0 0 -4px;
  border-radius: 2px 70% 2px 70%;
  background: var(--it-red);
  box-shadow: 0 0 12px rgba(192,32,43,.55);
  pointer-events: none;
  will-change: transform;
}
.impact-particle:nth-of-type(2n) { background: var(--it-cream); }

@media (max-width: 991px) {
  .services__scene::after { display: none; }
  .services__scene,
  .offers__scene { grid-template-columns: 1fr; min-height: auto; }
  .immersive-home .services,
  .immersive-home .offers { min-height: auto; padding: 90px 0; }
  .immersive-home .services-track { overflow-x: auto; width: auto; }
  .immersive-home .offers-grid { height: auto; display: grid; }
  .immersive-home .offer-card { position: relative; inset: auto; width: 100%; transform: none !important; }
  .immersive-home .offers-note,
  .immersive-home .offers-cta { position: static; }
  .offers__progress { display: none; }
  .immersive-home .process__card { height: auto; max-height: none; grid-template-columns: 1fr; }
  .immersive-home .process-visual { height: min(72vh, 620px); }
  .immersive-home .stats > .container-it { height: auto; max-height: none; }
  .immersive-home .stats-grid { height: auto; aspect-ratio: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 140px; }
  .immersive-home .stat-item { position: relative !important; inset: auto !important; width: 100%; }
}
@media (max-width: 640px) {
  .services__scene { padding-inline: 18px; }
  .immersive-home .service-card { width: 82vw; }
  .immersive-home .promise-title { font-size: clamp(2.25rem, 11vw, 3.8rem); }
  .promise__morph-wrap { width: 108vw; }
  .immersive-home .stats-grid { grid-template-columns: 1fr; }
  .immersive-home .stat-item { max-width: 290px; margin-inline: auto; }
  .immersive-home .testi-card { width: 84vw; }
  .immersive-home .blog-card { width: 84vw; }
}

/* ============================================================
   11. Grand titre animé — "Le digital, pour tous."
   ============================================================ */
.bigtitle {
  padding-block: calc(var(--section) * 0.9);
  background: var(--it-white);
  overflow: hidden;
}
.bigtitle h2 {
  text-align: center;
  font-size: clamp(3rem, 10.5vw, 10rem);
  line-height: 1.02;
  letter-spacing: -0.03em;
}
.bigtitle-line {
  display: block;
  white-space: nowrap;
}
.bigtitle-mask {
  display: inline-block;
  overflow: hidden;
  vertical-align: bottom;
}
.bigtitle-char {
  display: inline-block;
  will-change: transform;
}
.bigtitle-space {
  display: inline-block;
  width: 0.28em;
}
.bigtitle .accent {
  font-size: 1.04em;
}

/* ============================================================
   12. Blog / ressources
   ============================================================ */
.blog {
  background: var(--it-cream-soft);
}
.blog-head {
  text-align: center;
  max-width: 760px;
  margin-inline: auto;
}
.blog-head h2 {
  margin-top: 26px;
  font-size: clamp(2rem, 4vw, 3.8rem);
}
.blog-title-word {
  display: inline-block;
  white-space: pre;
}
.blog-sub {
  margin-top: 16px;
  font-size: 1.1rem;
}

.blog-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
  margin-top: 60px;
}
.blog-card__inner {
  display: flex;
  flex-direction: column;
  height: 100%;
  text-decoration: none;
  background: var(--it-white);
  border: 1px solid var(--it-border);
  border-radius: var(--r-card);
  overflow: hidden;
  transition: transform var(--ease-move), box-shadow var(--ease-move);
}
.blog-card__inner:hover {
  transform: translateY(-6px);
  box-shadow: var(--sh-md);
}
.blog-card__media {
  position: relative;
  aspect-ratio: 16/10;
  overflow: hidden;
  margin: 12px 12px 0;
  border-radius: calc(var(--r-card) - 6px);
  background: var(--it-border);
}
.blog-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.2, 0, 0, 1);
}
.blog-card__inner:hover .blog-card__media img {
  transform: scale(1.06);
}
.blog-card__cat {
  position: absolute;
  top: 12px;
  left: 12px;
  padding: 6px 13px;
  border-radius: var(--r-pill);
  background: rgba(14, 14, 12, 0.55);
  backdrop-filter: blur(8px);
  color: var(--it-cream);
  font-family: var(--f-head);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.blog-card__body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 20px 24px 24px;
}
.blog-card__meta {
  font-size: 0.8rem;
  color: var(--it-gray);
  font-family: var(--f-head);
}
.blog-card__body h3 {
  margin-top: 10px;
  font-size: 1.2rem;
  line-height: 1.35;
  transition: color var(--ease-color);
}
.blog-card__inner:hover h3 {
  color: var(--it-red);
}
.blog-card__excerpt {
  margin-top: 10px;
  font-size: 0.925rem;
  line-height: 1.6;
}
.blog-card__link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-top: auto;
  padding-top: 18px;
  font-family: var(--f-head);
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--it-ink);
  transition: color var(--ease-color);
}
.blog-card__link svg {
  width: 13px;
  height: 13px;
  color: var(--it-red);
  transition: transform var(--ease-move);
}
.blog-card__inner:hover .blog-card__link {
  color: var(--it-red);
}
.blog-card__inner:hover .blog-card__link svg {
  transform: translate(2px, -2px);
}
.blog-cta {
  display: flex;
  justify-content: center;
  margin-top: 46px;
}

@media (max-width: 991px) {
  .blog-grid {
    grid-template-columns: 1fr;
    max-width: 520px;
    margin-inline: auto;
  }
}

/* ============================================================
   13. Newsletter + Footer
   ============================================================ */
.newsletter {
  background: var(--it-cream-soft);
  padding-bottom: calc(var(--section) * 1.2);
}
.newsletter__card {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: stretch;
  background: var(--it-black);
  border-radius: var(--r-lg);
  overflow: hidden;
  position: relative;
}
.newsletter__card::before {
  content: "";
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 55%;
  aspect-ratio: 1;
  background: radial-gradient(circle, rgba(192, 32, 43, 0.18) 0%, transparent 65%);
  pointer-events: none;
}
.newsletter__inner {
  position: relative;
  z-index: 1;
  padding: clamp(44px, 5.5vw, 80px);
}
.newsletter__title {
  margin-top: 24px;
  color: var(--it-white);
  font-size: clamp(1.8rem, 3.2vw, 3rem);
}
.newsletter__sub {
  margin-top: 14px;
  max-width: 440px;
  color: rgba(247, 239, 217, 0.6);
}
.newsletter__form {
  display: flex;
  gap: 10px;
  margin-top: 30px;
  max-width: 480px;
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(247, 239, 217, 0.18);
  border-radius: var(--r-pill);
  padding: 6px;
}
.newsletter__form input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: 0;
  outline: none;
  padding: 12px 18px;
  color: var(--it-cream);
  font-family: var(--f-body);
  font-size: 0.95rem;
}
.newsletter__form input::placeholder {
  color: rgba(247, 239, 217, 0.4);
}
.newsletter__form button {
  border: 0;
  cursor: pointer;
  padding: 12px 26px;
  border-radius: var(--r-pill);
  background: var(--it-red);
  color: var(--it-white);
  font-family: var(--f-head);
  font-weight: 600;
  font-size: 0.95rem;
  transition: background-color var(--ease-color), transform 0.18s cubic-bezier(0.2, 0, 0, 1);
}
.newsletter__form button:hover {
  background: var(--it-red-dark);
}
.newsletter__form button:active {
  transform: scale(0.96);
}
.newsletter__done {
  margin-top: 30px;
  color: var(--it-cream);
  font-family: var(--f-head);
  font-weight: 600;
}
.newsletter__visual {
  position: relative;
  min-height: 300px;
}
.newsletter__visual img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* fondu vers le noir côté texte */
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 22%);
  mask-image: linear-gradient(90deg, transparent 0%, #000 22%);
}

/* Screen-reader only */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

/* ============================================================
   FOOTER — carte sombre, marque centrée (source unique de vérité)
   ============================================================ */
.footer {
  position: relative;
  z-index: 2;
  background: transparent;
  /* Pas de chevauchement négatif : sinon l'emblème flottant (centré sur le bord
     haut de la carte) remonte dans la zone du formulaire newsletter. */
  margin-top: 0;
}
.footer > .container-it {
  max-width: none;
  padding-inline: 0;
}
.footer__card {
  position: relative;
  overflow: visible;
  isolation: isolate;
  background: var(--it-black);
  color: rgba(247, 239, 217, 0.62);
  border-radius: 40px 40px 0 0;
  padding: clamp(72px, 8vw, 110px) clamp(24px, 6vw, 96px) 30px;
}
/* Icône flottante centrée sur le bord haut de la carte (style Golfclub).
   Ancrée sur .footer (et non .footer__card) pour échapper au contexte
   isolation:isolate de la carte, qui rognait sa moitié supérieure. */
.footer__emblem {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  pointer-events: none;
}
.footer__emblem img {
  width: clamp(140px, 18vw, 220px);
  height: auto;
  display: block;
}

/* Bloc marque centré */
.footer__brand {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 18px;
  padding-bottom: clamp(34px, 4vw, 52px);
  border-bottom: 1px solid rgba(247, 239, 217, 0.1);
}
.footer__logo {
  display: block;
}
.footer__logo img {
  height: clamp(38px, 4.4vw, 56px);
  width: auto;
  display: block;
}
.footer__tagline {
  font-family: var(--f-head);
  font-weight: 500;
  font-size: clamp(1.15rem, 2vw, 1.5rem);
  letter-spacing: -0.01em;
  color: var(--it-cream);
  max-width: 30ch;
}
.footer__tagline span {
  color: var(--it-red);
}
.footer__cta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin-top: 4px;
}

/* Colonnes */
.footer__cols {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap: clamp(28px, 4.5vw, 68px);
  padding: clamp(34px, 4vw, 54px) 0;
}
.footer__eyebrow {
  color: var(--it-red);
  font-family: var(--f-head);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 10px;
}
.footer__col h3 {
  color: var(--it-cream);
  font-family: var(--f-head);
  font-size: clamp(1.2rem, 1.6vw, 1.45rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  margin-bottom: 18px;
}
.footer__col ul {
  display: grid;
  gap: 11px;
}
.footer__col li {
  list-style: none;
  font-size: 0.95rem;
  line-height: 1.45;
  color: rgba(247, 239, 217, 0.62);
}
.footer__col a {
  color: rgba(247, 239, 217, 0.62);
  text-decoration: none;
  transition: color var(--ease-color);
}
.footer__col a:hover {
  color: var(--it-cream);
}
.footer__nav a,
.footer__socials a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.footer__nav a span,
.footer__socials a span {
  color: var(--it-red);
  transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1);
}
.footer__nav a:hover span,
.footer__socials a:hover span {
  transform: translate(3px, -3px);
}

/* Barre du bas */
.footer__bottom {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14px;
  padding-top: 22px;
  border-top: 1px solid rgba(247, 239, 217, 0.1);
  font-size: 0.85rem;
}
.footer__bottom > p span {
  color: var(--it-red);
}
.footer__legal {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px;
}
.footer__legal a {
  color: rgba(247, 239, 217, 0.62);
  text-decoration: none;
  transition: color var(--ease-color);
}
.footer__legal a:hover {
  color: var(--it-red);
}
.footer__legal span {
  color: rgba(247, 239, 217, 0.4);
}

@media (max-width: 991px) {
  .footer__cols {
    grid-template-columns: 1fr 1fr;
    gap: 34px 40px;
  }
  .footer__contact {
    grid-column: 1 / -1;
  }
}
@media (max-width: 640px) {
  .footer {
    margin-top: 0;
  }
  .footer__card {
    border-radius: 26px 26px 0 0;
    padding: 64px 22px 24px;
  }
  .footer__cols {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .footer__contact {
    grid-column: auto;
  }
  .footer__cta {
    width: 100%;
    flex-direction: column;
  }
  .footer__cta .btn-pill {
    justify-content: space-between;
  }
  .footer__bottom {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
}

/* ============================================================
   PAGES INTÉRIEURES — PageHero
   ============================================================ */
.page-hero {
  position: relative;
  min-height: 62svh;
  display: flex;
  align-items: flex-end;
