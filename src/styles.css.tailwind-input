  height: 28px;
}

.motion-card {
  --pointer-x: 50%;
  --pointer-y: 50%;
  position: relative;
  isolation: isolate;
  transform-style: preserve-3d;
  will-change: transform;
}
.motion-card__glow {
  position: absolute;
  z-index: 4;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  opacity: 0;
  background: radial-gradient(
    260px circle at var(--pointer-x) var(--pointer-y),
    rgba(255, 255, 255, .3),
    rgba(192, 32, 43, .08) 34%,
    transparent 67%
  );
