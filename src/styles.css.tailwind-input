}
.motion-card:hover .motion-card__glow { opacity: 1; }
.motion-card img { will-change: transform; }

.motion-line {
  display: block;
  overflow: hidden;
}
.motion-word {
  display: inline-block;
}

.section-badge,
.btn-pill,
.services-arrow,
.pf-filter,
.header__nav a,
.cta-banner__whatsapp {
