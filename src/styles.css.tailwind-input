  background-position: center 30%;
}
.page-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(14, 14, 12, 0.72) 0%,
    rgba(14, 14, 12, 0.45) 45%,
    rgba(14, 14, 12, 0.85) 100%
  );
}
.page-hero__content {
  position: relative;
  z-index: 2;
  padding-top: 170px;
  padding-bottom: 70px;
}
.page-hero__crumb {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--f-head);
  font-size: 0.85rem;
  color: rgba(247, 239, 217, 0.55);
}
.page-hero__crumb a {
  color: rgba(247, 239, 217, 0.8);
  text-decoration: none;
  transition: color var(--ease-color);
}
.page-hero__crumb a:hover {
  color: var(--it-red);
}
.page-hero__badge {
