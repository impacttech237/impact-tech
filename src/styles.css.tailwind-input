  .article-hero__footer > p { font-size: .94rem; }
  .article-hero__media { left: 18px; right: 18px; min-height: 300px; border-radius: 26px; }
  .article-reading { padding-top: 80px; }
  .article-progress { display: none; }
  .article-aside { grid-template-columns: 1fr auto; gap: 20px; }
  .article-aside__progress { width: 88px; }
  .article-toc { display: flex; overflow-x: auto; padding-bottom: 8px; }
  .article-toc > span { display: none; }
  .article-toc a { flex: 0 0 210px; }
  .article-chapter__head { grid-template-columns: 1fr; }
  .article-chapter__head > span { padding-top: 0; }
  .article-chapter > p,
  .article-chapter ul,
  .article-chapter blockquote,
  .article-callout { margin-left: 0; }
  .article-chapter h2 { font-size: clamp(2.5rem, 12vw, 4.6rem); }
  .article-content__image img { height: 52svh; border-radius: 24px; }
  .article-related__grid { grid-template-columns: 1fr; }
  .article-related__card:last-child { grid-column: auto; }
  .article-related__card > a { min-height: 560px; }
}
