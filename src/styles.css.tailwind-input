.motion-loader-mark {
  position: absolute;
  z-index: 2;
  left: 50%;
  top: 50%;
  width: clamp(120px, 11vw, 168px);
  aspect-ratio: 1 / 1;
  display: grid;
  place-items: center;
  transform: translate(-50%, -50%);
  transform-origin: center;
  filter: drop-shadow(0 18px 34px rgba(0, 0, 0, .28));
}
.motion-loader-mark::before {
  content: "";
  position: absolute;
  z-index: -1;
  width: 175%;
  aspect-ratio: 1;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(247,239,217,.18) 0%, rgba(247,239,217,0) 68%);
}
.motion-loader-mark svg {
  display: block;
  width: 100%;
